ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase — safe to expose only the publishable/anon key in the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY or a secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional privileged backend key. Never expose to browsers or mobile builds.
SUPABASE_SECRET_KEY=

# Mailtrap SMTP — server-side only; do not prefix these with NEXT_PUBLIC_.
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=api
MAILTRAP_PASSWORD=your-mailtrap-api-token
MAIL_FROM="TutaHealth <noreply@tutahealth.ge>"

# Cloudinary signed community photos.
# Use the same Cloudinary cloud name in both cloud-name fields.
# API secret is server-only; API key is returned only to authenticated upload clients.
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flitt payments — this build intentionally supports test mode only.
# Defaults use Flitt's public test merchant credentials; never put live keys in this example.
FLITT_MODE=test
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test
