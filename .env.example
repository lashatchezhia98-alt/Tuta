ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase — safe to expose only the publishable/anon key in the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY or a secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional privileged backend key. Never expose to browsers or mobile builds.
SUPABASE_SECRET_KEY=

# Mailtrap SMTP — server-side only; do not prefix these with NEXT_PUBLIC_.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password
MAIL_FROM="TUTA <hello@example.com>"
