# Public app configuration only. Values become readable inside the APK / IPA.
# Obtain URL and publishable key from your Supabase project's Connect dialog.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_TUTA_API_URL=https://tutahealth.ge
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Optional push-enabled builds. Project ID is public; never add provider secrets here.
EXPO_PUBLIC_TUTA_PUSH_PROJECT_ID=
TUTA_PUSH_IOS=0
TUTA_PUSH_GOOGLE_SERVICES_FILE=

# Never add Supabase secret/service_role keys, Mailtrap passwords or admin
# credentials here. Those belong only in the root backend .env.local.
# Photos use the website's signed upload endpoint; never place a Cloudinary
# API secret in this file. The URL and cloud name above are public values.
