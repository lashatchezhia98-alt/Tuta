{
  "expo": {
    "name": "თუთა • Tuta",
    "slug": "tuta-moon-mood",
    "scheme": "com.tutahealth.app",
    "version": "1.1.33",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "38",
      "appleTeamId": "D88588H2DS",
      "supportsTablet": true,
      "deploymentTarget": "26.6",
      "bundleIdentifier": "com.tutahealth.app"
    },
    "android": {
      "package": "com.tutahealth.app",
      "versionCode": 38,
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#E3D8F1"
      }
    },
    "web": {
      "name": "Tuta · Moon Mood"
    },
    "plugins": [
      "expo-font",
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "აირჩიე ერთი ფოტო თუთას საჯარო პოსტისთვის."
        }
      ],
      "expo-sharing",
      ["expo-location", {
        "locationWhenInUsePermission": "თუთა მდებარეობას იყენებს მხოლოდ მაშინ, როცა მიტანის პინის დასმას ითხოვ.",
        "locationAlwaysPermission": false,
        "locationAlwaysAndWhenInUsePermission": false
      }],
      "expo-web-browser"
    ]
  }
}
