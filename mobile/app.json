{
  "expo": {
    "name": "თუთა • Tuta",
    "slug": "tuta-moon-mood",
    "scheme": "com.tutahealth.app",
    "version": "1.1.4",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "8",
      "appleTeamId": "D88588H2DS",
      "supportsTablet": true,
      "deploymentTarget": "26.6",
      "bundleIdentifier": "com.tutahealth.app"
    },
    "android": {
      "package": "com.tutahealth.app",
      "versionCode": 8,
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#E3D8F1"
      }
    },
    "web": {
      "name": "Tuta · Moon Mood"
    },
    "plugins": [
      "expo-font",
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "აირჩიე ერთი ფოტო თუთას საჯარო პოსტისთვის."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ]
  }
}
